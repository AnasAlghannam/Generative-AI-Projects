# This project runs fully locally and does NOT use the shared root .env / GROQ_API_KEY.
# Copy this file to ".env" in this same folder if you want to override any defaults.

# Ollama model used for both chat replies and Hindsight's internal
# extraction/reflection. Must support tool calling (gemma3 does not).
OLLAMA_MODEL=qwen2.5:7b

# Ollama server address (default assumes `ollama serve` running locally)
OLLAMA_BASE_URL=http://localhost:11434

# Name of the local embedded Hindsight database instance (persists at
# ~/.pg0/instances/<value>). Change this if you want a fresh memory store.
HINDSIGHT_PROFILE=local-memory-chat

# Memory bank id - this app is single-user, so one fixed id is enough.
HINDSIGHT_BANK_ID=default-user

# Flask secret key (used to sign the session cookie holding chat history)
FLASK_SECRET_KEY=change-me

# Optional: enable Flask debug mode
DEBUG=false
