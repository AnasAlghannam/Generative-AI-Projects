# Shared credentials for all projects in this portfolio.
# Copy this file to ".env" in this same folder (the repo root) and fill in your key.
# Every project reads this one file, so there's no need for a separate .env per project.

# Groq API key (free tier at https://console.groq.com) - used by all projects
GROQ_API_KEY=your_api_key_here

# Flask secret key - used by ai-nutrition-coach
FLASK_SECRET_KEY=change-me

# Optional: enable debug mode for Flask-based projects
DEBUG=false
